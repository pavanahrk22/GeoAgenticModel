# ── Database ──────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./geoagentic.db
# Production (PostgreSQL — requires asyncpg in requirements.txt):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/geoagentic

# ── Routing ───────────────────────────────────────────────────
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=

# ── LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
# MUST be a valid JSON list — config.py types this as List[str].
# Add your Vercel domain here for production.
CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# ── Simulator ─────────────────────────────────────────────────
SIMULATOR_TICK_INTERVAL=1.0
